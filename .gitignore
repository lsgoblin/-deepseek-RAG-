# Python environments
.venv/
venv/
env/
.conda/
conda-meta/
*.conda
*.tar.bz2

# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.python-version

# Test, lint, and notebook caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# IDE settings
.idea/
.vscode/

# Local secrets
.env
.env.local
.env.*.local

# Logs
*.log
/outputs/*.log

# Local runtime artifacts
/vector_store/*
!/vector_store/.gitkeep

# Third-party Skill正文仅作本机采集与授权评估；避免误提交受限内容
/data/skills-showcase/*/SKILL.md
/data/skills-showcase/*/LICENSE.upstream

/outputs/experiment_results/*
!/outputs/experiment_results/.gitkeep

/ai_deliverables/*
!/ai_deliverables/.gitkeep

/reports/*
!/reports/.gitkeep

# If you do not want to upload demo screenshots, uncomment these lines:
# /outputs/screenshots/*
# !/outputs/screenshots/.gitkeep

# OS files
Thumbs.db
Desktop.ini
.DS_Store
